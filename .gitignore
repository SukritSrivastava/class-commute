# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / run logs
# Generic: every acceptance and generator run in this project writes a .log at
# the root, and naming them one at a time is how three dead entries accumulated.
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# playwright mcp debug artifacts
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# bundle analyzer output
/.next/analyze/

# Generated renders. design-shots/ is deliberately NOT here — those six states
# are committed evidence and the README embeds one of them.
/identity-preview.png

# Service worker build output (generated from app/sw.ts by `npm run build`).
# The icons in public/icons/ ARE committed — those are generated once, by hand,
# and the station list in lib/data/ is committed for the same reason.
/public/sw.js
/public/sw.js.map
