# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# playwright mcp debug artifacts
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# bundle analyzer output
/.next/analyze/

# station generator run logs (the generated JSON itself IS committed)
/.stations-refresh.log

# acceptance-run server log
/dev-acceptance.log

# identity preview render (regenerate with IDENTITY_PREVIEW=1)
/identity-preview.png

# service worker build output (generated from app/sw.ts by `npm run build`).
# The icons in public/icons/ ARE committed — those are generated once, by hand.
/public/sw.js
/public/sw.js.map

# acceptance-run server log
/offline-acceptance.log

# offline proof render (regenerate by running the offline acceptance spec)
/offline-proof.png
/interchange-proof.png
/interchange*.log
